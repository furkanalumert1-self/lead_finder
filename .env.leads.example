# Lead Radar: local single-user registry. `scripts/lead-radar.sh start` copies this to .env and
# fills the two secrets itself; never commit the filled .env.
TREG_DATABASE_URL=sqlite+aiosqlite:///./treg.db
TREG_PUBLIC_URL=http://127.0.0.1:18790
# Fernet key for stored API keys (`uv run python -m treg keygen`). Lose it and stored keys are gone.
TREG_SECRET_KEY=
# Replaces the built-in development token.
TREG_API_TOKEN=
# Opens /app and /leads signed in, only with local SQLite + a loopback public URL.
TREG_SINGLE_USER=1
# Bind to loopback only; the public URL alone does not restrict network access.
TREG_HOST=127.0.0.1
# Daily campaign schedule (Europe/Istanbul) in the server process; campaigns opt in one by one.
TREG_LEADS_SCHEDULER=1
TREG_TELEMETRY=0
DO_NOT_TRACK=1
# Only when not in single-user mode: a team token for the server's own /call/ (agent token).
# TREG_LEADS_TOKEN=
